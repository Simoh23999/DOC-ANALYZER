# Flask session signing key. required in prod.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Groq API key for AI Q&A. REQUIRED
GROQ_API_KEY=

# Port Flask/gunicorn listens on.
PORT=5000

# 1 for local dev (auto-reload + debugger), 0 in production.
FLASK_DEBUG=0

# Local defaults (keep as-is for dev):
DATABASE=documents.db
UPLOAD_FOLDER=uploads
# Docker/compose production values (uncomment when using volumes):
# DATABASE=/data/documents.db
# UPLOAD_FOLDER=/data/uploads
